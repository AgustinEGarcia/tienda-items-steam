# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — TIENDA DE INVENTARIOS CS2
# Copiar este archivo como .env.local y completar los valores reales.
# PROHIBIDO commitear archivos .env con credenciales reales.
# ==============================================================================

# Persistencia y Base de Datos (Supabase PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui

# Seguridad del Panel de Administración (/admin)
ADMIN_PASSWORD=cambiar_esta_clave_secreta_maestra_admin
SESSION_SECRET=generar_un_string_aleatorio_seguro_de_32_caracteres_minimo

# Parámetros Operativos de Steam
DEFAULT_APP_ID=730
DEFAULT_CONTEXT_ID=2
STEAM_CACHE_TTL_MINUTES=60
MAX_MANAGED_ACCOUNTS=5
STEAM_PRICE_DELAY_MS=2500
